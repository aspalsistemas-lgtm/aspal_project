# Todas las variables tienen un default razonable salvo las de Mailchimp: sin
# ellas, /api/suscripcion responde 503. La API de WordPress es pública y de
# solo lectura. Copia este archivo a .env solo si necesitas cambiar alguna.

# Puerto del servidor Express.
# En esta máquina el 5000 suele estar ocupado por otro proyecto: usa 5001.
PORT=5000

# Modo del servidor: "development" activa Vite con HMR; cualquier otro valor
# sirve el build de dist/. No hace falta definirlo: los scripts ya lo fijan
# (npm run dev → development, npm start → production). Se deja comentado para
# que copiar este archivo a .env no pise el valor del script.
# NODE_ENV=development

# Origen del contenido editorial (WordPress headless).
WP_API_BASE=https://comunidad.asociacionesprofesionales.org/wp-json/wp/v2

# Suscripción al boletín (POST /api/suscripcion → Mailchimp). Sin estas dos
# variables el endpoint responde 503. La clave termina en el centro de datos
# de la cuenta (p. ej. "…-us21"). En Vercel: Settings → Environment Variables.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
