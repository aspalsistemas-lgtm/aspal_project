{
  "name": "aspal",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de ASPAL: el sitio público (apps/sitio) y la plataforma (apps/plataforma)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Antonio1491/aspal_project.git"
  },
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aspal/sitio",
    "build": "npm run build -w @aspal/sitio",
    "start": "npm run start -w @aspal/sitio",
    "check": "npm run check -w @aspal/sitio",
    "check:assets": "npm run check:assets -w @aspal/sitio",
    "check:browser": "npm run check:browser -w @aspal/sitio --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @aspal/sitio --",
    "test:coverage": "npm run test:coverage -w @aspal/sitio",
    "test:watch": "npm run test:watch -w @aspal/sitio",
    "dev:plataforma": "npm run dev -w @aspal/plataforma",
    "build:plataforma": "npm run build -w @aspal/plataforma",
    "check:plataforma": "npm run check -w @aspal/plataforma",
    "test:plataforma": "npm run test -w @aspal/plataforma",
    "test:integracion": "npm run test:integracion -w @aspal/plataforma",
    "db:levantar": "docker compose up -d --wait db && npm run db:preparar",
    "db:migrar": "npm run db:migrar -w @aspal/plataforma",
    "db:generar": "npm run db:generar -w @aspal/plataforma",
    "plataforma:levantar": "docker compose up -d --build --wait",
    "plataforma:detener": "docker compose down",
    "db:preparar": "npm run db:preparar -w @aspal/plataforma",
    "db:sembrar": "npm run db:sembrar -w @aspal/plataforma"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
