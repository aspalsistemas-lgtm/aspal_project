{
  "name": "@aspal/plataforma",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS de ASPAL: API, paneles y páginas públicas por asociación",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file=local.env src/servidor.ts",
    "build": "esbuild src/servidor.ts src/migrar.ts src/preparar-base.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/servidor.js",
    "check": "tsc",
    "db:preparar": "tsx --env-file=local.admin.env src/preparar-base.ts",
    "db:migrar": "tsx --env-file=local.admin.env src/migrar.ts",
    "db:generar": "drizzle-kit generate",
    "test": "vitest run",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "db:sembrar": "tsx --env-file=local.admin.env src/sembrar.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
