# Entorno de la APLICACIÓN en desarrollo local (npm run dev:plataforma). Solo lo
# que el servidor necesita: la URL del rol aspal_app, sujeto a RLS. Credenciales
# solo locales, iguales a las de compose.yaml. Las de administración viven en
# local.admin.env y el servidor nunca las carga (auditoría del corte 2, hallazgo 8).

DATABASE_URL=postgres://aspal_app:aspal_app_local@localhost:5433/aspal
DOMINIO_BASE=localhost
PORT=5010
