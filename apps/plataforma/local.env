# Entorno de desarrollo local de la plataforma (Docker, compose.yaml). Son
# credenciales SOLO locales, iguales a las de compose.yaml: no protegen nada
# fuera de esta máquina. En la nube cada variable sale de un gestor de secretos.
#
# La aplicación solo conoce DATABASE_URL (rol aspal_app, sujeto a RLS). La URL
# de administrador la usan db:preparar, db:migrar y db:sembrar, nunca el servidor.

DATABASE_URL=postgres://aspal_app:aspal_app_local@localhost:5433/aspal
DOMINIO_BASE=localhost
PORT=5010

DATABASE_URL_ADMIN=postgres://aspal:aspal_local@localhost:5433/aspal
DATABASE_PASSWORD_APP=aspal_app_local

# Tests de integración: una base desechable que se recrea en cada pasada.
DATABASE_URL_PRUEBA_ADMIN=postgres://aspal:aspal_local@localhost:5433/aspal_prueba
DATABASE_URL_PRUEBA_APP=postgres://aspal_app:aspal_app_local@localhost:5433/aspal_prueba
