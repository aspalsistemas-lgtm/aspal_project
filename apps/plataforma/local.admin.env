# Entorno de ADMINISTRACIÓN en desarrollo local: db:preparar, db:migrar,
# db:sembrar y los tests de integración. Nunca lo carga el servidor. Credenciales
# solo locales, iguales a las de compose.yaml.

DATABASE_URL_ADMIN=postgres://aspal:aspal_local@localhost:5433/aspal
DATABASE_PASSWORD_APP=aspal_app_local

# Tests de integración: una base desechable que se recrea en cada pasada.
DATABASE_URL_PRUEBA_ADMIN=postgres://aspal:aspal_local@localhost:5433/aspal_prueba
DATABASE_URL_PRUEBA_APP=postgres://aspal_app:aspal_app_local@localhost:5433/aspal_prueba
